# ============================================================
# MPDIA — Spring Boot Backend Configuration
# ============================================================
# INSTRUCCIONES:
# 1. Copia este archivo como "application.properties"
# 2. Reemplaza los valores de ejemplo con tus configuraciones reales
# 3. NUNCA subas application.properties a Git (ya está en .gitignore)
# ============================================================

# Server
server.port=8080

# PostgreSQL DataSource
spring.datasource.url=jdbc:postgresql://localhost:5433/mpdia_db
spring.datasource.username=mpdia_user
spring.datasource.password=mpdia_pass
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=none

# Flyway
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration
spring.flyway.repair-on-migrate=true
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true

# JWT
mpdia.jwt.secret=mpdia-super-secret-key-change-in-production-min-256-bits
mpdia.jwt.expiration-ms=86400000

# CORS — Angular dev server
mpdia.cors.allowed-origins=http://localhost:4200

# Gemini AI
# Obtén tu API key en: https://aistudio.google.com/app/apikey
mpdia.gemini.api-key=TU_API_KEY_DE_GEMINI_AQUI
mpdia.gemini.api-url=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent

# Logging
logging.level.com.mpdia=DEBUG
logging.level.org.springframework.security=INFO

# Email (Gmail SMTP) — configurar contraseña de app real antes de usar invitaciones por email
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=tu-email@gmail.com
spring.mail.password=tu-password-de-app-aqui
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.connectiontimeout=3000
spring.mail.properties.mail.smtp.timeout=3000
spring.mail.test-connection=false
spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.mail.MailSenderAutoConfiguration
mpdia.app.url=http://localhost:4200
